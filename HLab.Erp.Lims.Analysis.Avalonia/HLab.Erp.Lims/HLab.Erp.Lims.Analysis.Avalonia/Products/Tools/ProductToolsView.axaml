<UserControl x:Class="HLab.Erp.Lims.Analysis.Avalonia.Products.Tools.ProductToolsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:HLab.Localization.Avalonia.Lang;assembly=HLab.Localization.Avalonia"
             x:CompileBindings="False"
             >
    <Grid>
        <ScrollViewer>
        <StackPanel>
            <lang:LocalizedLabel Text="{}{Domain} : "/>
            <TextBox Text="{Binding Message}" TextWrapping="Wrap" Height="300"/>

            <Button Command="{Binding GenerateComponentsCommand}">
                <lang:Localize Id="{}{Generate Components}"/>
            </Button>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
