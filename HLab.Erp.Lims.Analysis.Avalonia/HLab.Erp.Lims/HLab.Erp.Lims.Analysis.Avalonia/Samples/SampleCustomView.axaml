<UserControl x:Class="HLab.Erp.Lims.Analysis.Avalonia.Samples.SampleCustomView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HLab.Erp.Core.Avalonia.Views;assembly=HLab.Erp.Core.Avalonia"
             xmlns:lang="clr-namespace:HLab.Localization.Avalonia.Lang;assembly=HLab.Localization.Avalonia"
             x:CompileBindings="False">
    <!-- RECORD -->
    <views:DetailView EditMode="{Binding EditMode}" Text="Conformité de l'échantillon réceptionné" IconPath="Icons/Sample/Folder">

        <!-- TODO : YesNoView (AllowNa) non porté — CheckBox tri-état en attendant -->
        <lang:LocalizedLabel Text="{}{Technical CD} : "/>
        <CheckBox IsThreeState="True" IsChecked="{Binding Model.TechnicalCD}" />

        <lang:LocalizedLabel Text="{}{Sufficient quantity} : "/>
        <CheckBox IsChecked="{Binding Model.SufficientQuantity}" />

        <lang:LocalizedLabel Text="{}{Anomaly detected} : "/>
        <CheckBox IsChecked="{Binding Model.AnomalyDetected}" />

        <lang:LocalizedLabel Text="{}{Received sample} : "/>
        <CheckBox IsChecked="{Binding Model.ReceivedSample}" />

    </views:DetailView>

</UserControl>
