<UserControl x:Class="HLab.Erp.Lims.Analysis.Avalonia.Samples.SampleTests.TestView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:entityLists="clr-namespace:HLab.Erp.Core.Avalonia.EntityLists;assembly=HLab.Erp.Core.Avalonia"
             x:CompileBindings="False"
            >
    <entityLists:ColumnDescriptionBlock
            Title="{Binding Model.TestName}"
            Description="{Binding Model.Description}"
            IconPath="{Binding Model.TestClass.IconPath}"
    />
</UserControl>
