<UserControl x:Class="HLab.Erp.Lims.Analysis.Avalonia.Samples.SampleTests.SampleTestResults.SampleTestResultView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:details="clr-namespace:HLab.Erp.Core.Tools.Details;assembly=HLab.Erp.Core"
             xmlns:mvvm="clr-namespace:HLab.Mvvm.Avalonia;assembly=HLab.Mvvm.Avalonia"
             x:CompileBindings="False"
             Background="{DynamicResource HLab.Brushes.Background}"
             >
    <Grid ColumnDefinitions="*,5,2*">

        <Grid>
            <mvvm:ViewLocator ViewClass="{x:Type details:IDetailViewClass}" Model="{Binding}"/>
        </Grid>

        <GridSplitter Grid.Column="1"/>

        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding FormHelper.Form}" IsEnabled="{Binding EditMode}" />
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
